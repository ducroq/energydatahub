{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/verify_edit.py\"",
            "timeout": 120,
            "statusMessage": "Verifying edit"
          }
        ]
      }
    ]
  }
}
